{
  "name": "fortress-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @fortress/web dev",
    "build": "pnpm --filter @fortress/web build",
    "start": "pnpm --filter @fortress/web start",
    "lint": "pnpm --filter @fortress/web lint",
    "typecheck": "pnpm --filter @fortress/web exec tsc --noEmit",
    "db:generate": "pnpm --filter @fortress/web exec prisma generate",
    "db:migrate": "pnpm --filter @fortress/web exec prisma migrate deploy",
    "db:push": "pnpm --filter @fortress/web exec prisma db push",
    "db:studio": "pnpm --filter @fortress/web exec prisma studio"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
