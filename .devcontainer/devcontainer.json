{
  "name": "Fortress Finance Web",

  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers-extra/features/pnpm:2": {
      "version": "latest"
    }
  },

  "containerEnv": {
    "HOME": "/home/vscode",
    "USER": "vscode",
    "PNPM_STORE_DIR": "/home/vscode/.pnpm-store"
  },

  "initializeCommand": "mkdir -p /home/vscode/.pnpm-store /home/codespace/.config/vscode-dev-containers && chown -R vscode:vscode /home/vscode /home/codespace || true",

  "mounts": [
    "source=pnpm-store,target=/home/vscode/.pnpm-store,type=volume"
  ],

  "forwardPorts": [3000, 5432],

  "portsAttributes": {
    "3000": {
      "label": "Fortress Finance",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": "corepack enable && pnpm install --frozen-lockfile",

  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "GitHub.copilot",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  "remoteUser": "vscode"
}
